{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/images/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/checkout/merch",
      "destination": "/merch-checkout"
    },
    {
      "source": "/checkout/:eventId",
      "destination": "/checkout"
    },
    {
      "source": "/checkout/:eventId/(.*)",
      "destination": "/checkout"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin"
    },
    {
      "source": "/reset-password/:path*",
      "destination": "/reset-password"
    },
    {
      "source": "/magic-login/:path*",
      "destination": "/magic-login"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/keep-alive",
      "schedule": "0 0 */5 * *"
    }
  ]
}
