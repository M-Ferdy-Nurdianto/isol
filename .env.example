# Kohi Sekai - Environment Configuration Template
# Copy this file to create your local .env files.
# Separate .env files exist in /backend and /frontend for isolated runtime environments.

# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES (backend/.env)
# ==============================================================================

# HTTP Port for Express Server
PORT=5000
NODE_ENV=development

# Supabase API Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# JWT Authentication Secret
JWT_SECRET=your-random-secure-jwt-secret-string-here

# Frontend Application URL (for CORS validation)
FRONTEND_URL=http://localhost:3000

# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (frontend/.env)
# ==============================================================================

# Supabase Client Credentials
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend API Endpoint
VITE_API_URL=http://localhost:5000/api

# Email Configuration:
# - Online / Production (Resend - Recommended for Vercel Serverless):
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev

# - Local / Development (Nodemailer SMTP / Gmail / Inbucket):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-gmail-app-password

# Cloudflare Turnstile CAPTCHA (Bot Protection)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAF_your_site_key_here
TURNSTILE_SECRET_KEY=0x4AAAAAAF_your_secret_key_here


