{
  "name": "kohi-sekai-workspace",
  "version": "1.0.0",
  "description": "Monorepo for Kohi Sekai Website",
  "type": "module",
  "scripts": {
    "install:all": "pnpm install && cd frontend && pnpm install && cd ../backend && pnpm install && cd ../api && pnpm install",
    "dev:frontend": "cd frontend && pnpm dev",
    "dev:backend": "cd backend && pnpm dev",
    "dev": "concurrently --names \"API,WEB\" --prefix-colors \"cyan.bold,magenta.bold\" --kill-others-on-fail \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "start": "pnpm run dev",
    "build": "cd frontend && pnpm install && pnpm run build",
    "build:frontend": "cd frontend && pnpm run build",
    "start:backend": "cd backend && pnpm start",
    "vercel-build": "pnpm run build"
  },
  "keywords": [
    "kohi-sekai",
    "cheki",
    "idol"
  ],
  "author": "Kohi Sekai",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.3",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "express-slow-down": "^2.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.34.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "supabase": "^2.117.0"
  }
}
